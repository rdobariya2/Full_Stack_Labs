# Copy to .env for local development. Do NOT commit a real .env.
# The back-end reads DATABASE_URL from the environment (never hard-coded).
PORT=3000

# --- Local database (Docker, see docker-compose.yml) ---
# Start it with: docker compose up -d   (from this backend/ folder)
DATABASE_URL="postgresql://pixell:pixell@localhost:5432/pixell_river?schema=public"

# --- Hosted database (Vercel / Neon) ---
# In Vercel, add the Neon Postgres integration to the project, then
# copy its DATABASE_URL into Vercel's Environment Variables
# (and into a local .env for testing against Neon). It looks like:
# DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"
# Neon needs ?sslmode=require; the local Docker URL above does not.
# Do NOT put a real Neon password in this file or commit it.

# Comma-separated list of origins allowed to call this API.
# Requests with no Origin header (curl / Postman) are also allowed.
# Any other browser Origin is rejected with 403.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:8080,http://localhost:3000
