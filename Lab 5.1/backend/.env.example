# Copy to .env for local use. Do not commit a real .env.
PORT=3000

# Local database (Docker, see docker-compose.yml)
# Start it with: docker compose up -d (from this backend/ folder)
DATABASE_URL="postgresql://pixell:pixell@localhost:5432/pixell_river?schema=public"

# Hosted database (Vercel / Neon)
# Copy the Neon DATABASE_URL here to test against Neon.
# It looks like:
# DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"
# Neon needs ?sslmode=require. Do not put a real Neon password in this file.

# Origins allowed to call this API. Requests with no Origin
# header (curl / Postman) are also allowed.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:8080,http://localhost:3000

# Clerk (Lab 5.1) - copy both keys from the Clerk Dashboard, API keys page.
# The secret key stays in .env only. Never commit it.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
